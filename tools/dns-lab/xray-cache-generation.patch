@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: MPL-2.0
+// Experimental cache-only primitive. Not wired into the Android wrapper or any controller.
+package dns
+
+import (
+	"context"
+	"errors"
+	"strconv"
+)
+
+var errCacheGenerationChanged = errors.New("DNS cache generation changed")
+
+type cacheScope struct {
+	owner   *CacheController
+	id      uint64
+	context context.Context
+}
+
+func (s cacheScope) key(name string) string { return strconv.FormatUint(s.id, 10) + ":" + name }
+func (c *CacheController) scope() cacheScope {
+	c.RLock()
+	defer c.RUnlock()
+	return cacheScope{c, c.generation, c.generationContext}
+}
+func (c *CacheController) owns(s cacheScope) bool {
+	c.RLock()
+	defer c.RUnlock()
+	return s.owner == c && s.id == c.generation
+}
+
+// FlushGeneration isolates newly admitted queries from previous replies, waiters,
+// singleflight and migration. It is NOT a resolver-policy reload, an engine-wide
+// flush, a transport drain or an Android API. Calls already returned to an
+// outbound before this barrier cannot be recalled by this cache primitive.
+func (c *CacheController) FlushGeneration() uint64 {
+	c.Lock()
+	defer c.Unlock()
+	c.cancelGeneration()
+	c.generation++
+	c.generationContext, c.cancelGeneration = context.WithCancel(context.Background())
+	c.ips = make(map[string]*record)
+	c.dirtyips = nil
+	c.highWatermark = 0
+	return c.generation
+}
