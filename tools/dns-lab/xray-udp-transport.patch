+// Called only by the reader closure of THIS epoch, never by looking up the
+// server's latest transport. Old bytes must not acquire the newest request map.
+func (e *dnsTransportEpoch) handle(payload *buf.Buffer) {
+	defer payload.Release()
+	var parser dnsmessage.Parser
+	header, err := parser.Start(payload.Bytes())
+	if err != nil || !header.Response || header.OpCode != 0 {
+		return
+	}
+	question, err := parser.Question()
+	if err != nil {
+		return
+	}
+	if _, err = parser.Question(); err != dnsmessage.ErrSectionDone {
+		return
+	}
+	answer, err := parseResponse(payload.Bytes())
+	if err != nil {
+		return
+	}
+	e.mu.Lock()
+	if e.retired || e.ctx.Err() != nil || !e.server.cacheController.owns(e.scope) {
+		e.mu.Unlock()
+		return
+	}
+	req := e.requests[header.ID]
+	if req == nil || len(req.msg.Questions) != 1 {
+		e.mu.Unlock()
+		return
+	}
+	expected := req.msg.Questions[0]
+	if !strings.EqualFold(question.Name.String(), expected.Name.String()) || question.Type != expected.Type || question.Class != expected.Class {
+		e.mu.Unlock()
+		return
+	}
+	delete(e.requests, header.ID)
+	e.lastActivity = time.Now()
+	if req.expire.Before(time.Now()) || req.ctx.Err() != nil {
+		e.mu.Unlock()
+		notifyDNS(req.failure, context.DeadlineExceeded)
+		return
+	}
+	if header.Truncated {
+		if len(req.msg.Additionals) != 0 {
+			e.mu.Unlock()
+			notifyDNS(req.failure, errUDPTruncated)
 			return
 		}
