+// Never wait for routing.Dispatch, ReadMultiBuffer or WriteMultiBuffer while
+// holding the server/epoch lock. A bounded reaper owns late initialization.
+func (e *dnsTransportEpoch) retireLocked() bool {
+	if e.retired {
+		return false
+	}
+	e.retired = true
+	e.cancel()
+	if e.stopGeneration != nil {
+		e.stopGeneration()
+	}
+	if e.timer != nil {
+		e.timer.Stop()
+	}
+	for id, r := range e.requests {
+		delete(e.requests, id)
+		notifyDNS(r.failure, errUDPTransportRetired)
+	}
+	return true
+}
+func (e *dnsTransportEpoch) reap() {
+	<-e.ready
+	e.mu.Lock()
+	link := e.link
+	e.mu.Unlock()
+	var closeErr error
+	if link != nil {
+		closeErr = errors.Join(common.Interrupt(link.Reader), common.Interrupt(link.Writer))
+	}
+	e.mu.Lock()
+	e.cleanupErr = closeErr
+	// An explicit cleanup error cannot be treated as a successful release.
+	e.cleanupDone = closeErr == nil
+	e.releaseLocked()
+	e.mu.Unlock()
+}
+func (e *dnsTransportEpoch) retire() {
+	e.mu.Lock()
+	retire := e.retireLocked()
+	e.mu.Unlock()
+	if retire {
+		go e.reap()
+	}
+}
+func (e *dnsTransportEpoch) expireIdle() {
+	e.mu.Lock()
+	if e.retired {
+		e.mu.Unlock()
+		return
+	}
+	if remaining := time.Minute - time.Since(e.lastActivity); remaining > 0 {
+		e.timer.Reset(remaining)
+		e.mu.Unlock()
+		return
+	}
+	// Atomic with new write admission: a delayed timer cannot retire a newly
+	// active transport based on an old snapshot of its last activity.
+	retire := e.retireLocked()
+	e.mu.Unlock()
+	if retire {
+		go e.reap()
+	}
+}
+func (e *dnsTransportEpoch) read() {
+	defer e.done()
+	defer e.retire()
+	for {
+		if e.ctx.Err() != nil {
+			return
+		}
+		mb, err := e.link.Reader.ReadMultiBuffer()
+		for _, payload := range mb {
+			e.handle(payload)
+		}
+		if err != nil {
+			return
+		}
+	}
