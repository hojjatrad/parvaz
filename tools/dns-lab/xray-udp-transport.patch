 func (s *ClassicNameServer) RequestsCleanup() error {
+	s.Lock()
+	e := s.current
+	s.Unlock()
+	if e == nil {
+		return errUDPTransportRetired
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
 	now := time.Now()
+	for id, r := range e.requests {
+		if r.expire.Before(now) {
+			delete(e.requests, id)
+			notifyDNS(r.failure, context.DeadlineExceeded)
+		}
+	}
+	if len(e.requests) == 0 {
+		return errors.New("no pending DNS requests")
+	}
+	return nil
+}
