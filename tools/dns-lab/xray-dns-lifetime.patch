@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: MPL-2.0
+// Experimental in-process logical invalidation, NOT an engine-wide flush API.
+package dns
+
+import (
+	"context"
+	"errors"
+	"math"
+	"sync"
+
+	"github.com/xtls/xray-core/common/net"
+	dnsfeature "github.com/xtls/xray-core/features/dns"
+)
+
+var errDNSLifetimeChanged = errors.New("DNS lookup lifetime changed")
+var errDNSLifetimeClosed = errors.New("DNS lookup lifetime closed")
+
+type parvazDNSScopesKey struct{}
+type parvazDNSLifetime struct {
+	mu       sync.Mutex
+	revision uint64
+	closed   bool
+	ctx      context.Context
+	cancel   context.CancelFunc
+}
+
+// Result deliberately has no successful full-chain/transport-drain outcome.
+// Static mappings are configuration, not a cache to delete. No policy is reloaded.
+type ParvazDNSControlResult struct {
+	Status              string `json:"status"`
+	Revision            uint64 `json:"revision"`
+	LogicalApplied      bool   `json:"logical_applied"`
+	CacheControllers    int    `json:"cache_controllers"`
+	UncoveredConditions int    `json:"uncovered_conditions"`
+	OwnedUDPLeases      int    `json:"owned_udp_leases"`
+	FullChainFlushed    bool   `json:"full_chain_flushed"`
+	RebuildRequired     bool   `json:"rebuild_required"`
+}
+
+func (s *DNS) parvazScopeLocked() context.Context {
+	if s.parvaz.ctx == nil {
+		root := s.ctx
+		if root == nil {
+			root = context.Background()
+		}
+		scopes := make(map[*CacheController]cacheScope)
+		for _, client := range s.clients {
+			if client != nil {
+				if c, ok := client.server.(CachedNameserver); ok && c.getCacheController() != nil {
+					cc := c.getCacheController()
+					scopes[cc] = cc.scope()
+				}
+			}
+		}
+		s.parvaz.ctx, s.parvaz.cancel = context.WithCancel(context.WithValue(root, parvazDNSScopesKey{}, scopes))
+	}
+	return s.parvaz.ctx
+}
+func (s *DNS) LookupIP(domain string, option dnsfeature.IPOption) ([]net.IP, uint32, error) {
+	s.parvaz.mu.Lock()
+	if s.parvaz.closed {
+		s.parvaz.mu.Unlock()
+		return nil, 0, errDNSLifetimeClosed
+	}
+	ctx := s.parvazScopeLocked()
+	revision := s.parvaz.revision
+	s.parvaz.mu.Unlock()
+	ips, ttl, err := s.lookupIPInLifetime(ctx, domain, option)
+	s.parvaz.mu.Lock()
+	defer s.parvaz.mu.Unlock()
+	if s.parvaz.closed {
+		return nil, 0, errDNSLifetimeClosed
+	}
+	if revision != s.parvaz.revision {
+		return nil, 0, errDNSLifetimeChanged
+	}
+	if ctx.Err() != nil {
+		return nil, 0, ctx.Err()
+	}
+	return ips, ttl, err
+}
+func (s *DNS) parvazReportLocked(status string, applied bool) ParvazDNSControlResult {
+	r := ParvazDNSControlResult{Status: status, Revision: s.parvaz.revision, LogicalApplied: applied, RebuildRequired: true}
+	seen := make(map[*CacheController]bool)
+	udpSeen := make(map[*ClassicNameServer]bool)
+	for _, client := range s.clients {
+		if client == nil || client.server == nil {
+			r.UncoveredConditions++
+			continue
+		}
+		if c, ok := client.server.(CachedNameserver); ok && c.getCacheController() != nil {
+			cc := c.getCacheController()
+			if !seen[cc] {
+				r.CacheControllers++
+				seen[cc] = true
+			}
+		}
+		if u, ok := client.server.(*ClassicNameServer); ok {
+			if !udpSeen[u] {
+				r.OwnedUDPLeases += len(u.slots)
+				udpSeen[u] = true
+			}
+		} else {
+			r.UncoveredConditions++
+		}
+		if client.checkSystem {
+			r.UncoveredConditions++
+		}
+	}
+	if s.checkSystem || len(s.clients) == 0 || len(s.clients) > 64 {
+		r.UncoveredConditions++
+	}
+	return r
+}
+func (s *DNS) ParvazDNSControlState() ParvazDNSControlResult {
+	if !s.parvaz.mu.TryLock() {
+		return ParvazDNSControlResult{Status: "BUSY", RebuildRequired: true}
+	}
+	defer s.parvaz.mu.Unlock()
+	if s.parvaz.closed {
+		return s.parvazReportLocked("CLOSED", false)
+	}
+	report := s.parvazReportLocked("EXPERIMENTAL_LOGICAL_ONLY", false)
+	if report.UncoveredConditions > 0 {
+		report.Status = "UNSUPPORTED_REBUILD_REQUIRED"
+	}
+	return report
+}
+
+// TryInvalidate checks the entire configured nameserver set before ANY mutation.
+// The immutable configuration, static hosts, system and remote caches are not
+// reloaded/cleared. Callers must retain conservative rebuild, not report green.
+func (s *DNS) ParvazTryInvalidateDNS(expected uint64) ParvazDNSControlResult {
+	if !s.parvaz.mu.TryLock() {
+		return ParvazDNSControlResult{Status: "BUSY", RebuildRequired: true}
+	}
+	defer s.parvaz.mu.Unlock()
+	if s.parvaz.closed {
+		return s.parvazReportLocked("CLOSED", false)
+	}
+	if expected != s.parvaz.revision {
+		return s.parvazReportLocked("STALE_REVISION", false)
+	}
+	report := s.parvazReportLocked("UNSUPPORTED_REBUILD_REQUIRED", false)
+	if report.UncoveredConditions != 0 {
+		return report
+	}
+	if expected == math.MaxUint64 {
+		return s.parvazReportLocked("REVISION_EXHAUSTED", false)
+	}
+	caches := make(map[*CacheController]bool)
+	for _, client := range s.clients {
+		c := client.server.(CachedNameserver).getCacheController()
+		c.RLock()
+		unusable := c.permanentlyClosed || c.generation == math.MaxUint64
+		c.RUnlock()
+		if unusable {
+			return s.parvazReportLocked("CACHE_LIFETIME_UNAVAILABLE", false)
+		}
+		caches[c] = true
+	}
+	if s.parvaz.cancel != nil {
+		s.parvaz.cancel()
+	}
+	for c := range caches {
+		c.FlushGeneration()
+	}
+	s.parvaz.revision++
+	s.parvaz.ctx = nil
+	s.parvazScopeLocked()
+	return s.parvazReportLocked("LOGICAL_INVALIDATED_REBUILD_REQUIRED", true)
+}
+
+// Close fences admissions and publication immediately. Native cleanup remains
+// owned by the transport reaper; returning here is NOT a native-drain receipt.
+func (s *DNS) Close() error {
+	s.parvaz.mu.Lock()
+	defer s.parvaz.mu.Unlock()
+	if s.parvaz.closed {
+		return nil
+	}
+	s.parvaz.closed = true
+	if s.parvaz.cancel != nil {
+		s.parvaz.cancel()
+	}
+	for _, client := range s.clients {
+		if client == nil {
+			continue
+		}
+		if c, ok := client.server.(CachedNameserver); ok && c.getCacheController() != nil {
+			c.getCacheController().closePermanent()
+		}
+		if u, ok := client.server.(*ClassicNameServer); ok {
+			u.cleanupGate.Lock()
+			u.requestsCleanup.Close()
+			u.cleanupGate.Unlock()
+		}
+	}
+	return nil
+}
+func (c *CacheController) closePermanent() {
+	c.Lock()
+	if !c.permanentlyClosed {
+		c.permanentlyClosed = true
+		c.cancelGeneration()
+		if c.generation != math.MaxUint64 {
+			c.generation++
+		}
+		c.ips = make(map[string]*record)
+		c.dirtyips = nil
+		c.highWatermark = 0
+	}
+	c.Unlock()
+	c.cleanupGate.Lock()
+	c.cacheCleanup.Close()
+	c.cleanupGate.Unlock()
+}
+func (c *CacheController) startCleanup(scope cacheScope) {
+	c.cleanupGate.Lock()
+	defer c.cleanupGate.Unlock()
+	if c.owns(scope) {
+		_ = c.cacheCleanup.Start()
+	}
+}
+func (s *ClassicNameServer) startRequestsCleanup(scope cacheScope) {
+	s.cleanupGate.Lock()
+	defer s.cleanupGate.Unlock()
+	if s.cacheController.owns(scope) {
+		_ = s.requestsCleanup.Start()
+	}
+}
