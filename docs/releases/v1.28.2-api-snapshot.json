  "tarball_url": "https://api.github.com/repos/hojjatrad/parvaz/tarball/v1.28.2",
  "zipball_url": "https://api.github.com/repos/hojjatrad/parvaz/zipball/v1.28.2",
  "body": "# Parvaz 1.28.2 \u2014 \u067e\u06cc\u0648\u0633\u062a\u06af\u06cc \u062a\u0634\u062e\u06cc\u0635 DNS \u067e\u0633 \u0627\u0632 \u0642\u0637\u0639 \u0648 \u0628\u0631\u06af\u0634\u062a \u0634\u0628\u06a9\u0647\n\nversionCode 36\u061b \u0647\u0645\u0627\u0646 \u0628\u0633\u062a\u0647 \u0648 \u06af\u0648\u0627\u0647\u06cc \u062f\u0627\u0626\u0645\u06cc. \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0627\u0646\u062a\u0634\u0627\u0631 \u062c\u062f\u06cc\u062f \u0627\u0633\u062a\u061b \u0646\u0633\u062e\u0647\u200c\u0647\u0627\u06cc \u0642\u0628\u0644\u06cc \u0628\u0627\u0632\u0646\u0648\u06cc\u0633\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f.\n\n## \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a\n\n- \u0628\u0627\u0632\u06af\u0634\u062a \u0647\u0645\u0627\u0646 Network handle \u0628\u0639\u062f \u0627\u0632 \u0641\u0642\u062f\u0627\u0646 \u0634\u0628\u06a9\u0647\u060c \u062f\u06cc\u06af\u0631 \u0646\u0634\u0627\u0646\u0647\u0654 \u062b\u0627\u0628\u062a\u200c\u0645\u0627\u0646\u062f\u0646 DNS \u0641\u0631\u0636 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0645\u0634\u062e\u0635\u0627\u062a \u062c\u0627\u0631\u06cc \u062f\u0648\u0628\u0627\u0631\u0647 \u062e\u0648\u0627\u0646\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b DNS \u0645\u062a\u0641\u0627\u0648\u062a\u060c cache \u0642\u0628\u0644\u06cc \u0631\u0627 \u0646\u0627\u0645\u0639\u062a\u0628\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0627\u06af\u0631 snapshot \u0634\u0646\u0627\u062e\u062a\u0647\u200c\u0634\u062f\u0647\u0654 DNS \u062b\u0627\u0628\u062a \u0628\u0627\u0634\u062f\u060c \u0635\u0631\u0641 \u0628\u0631\u06af\u0634\u062a \u0634\u0628\u06a9\u0647 \u0645\u0648\u062c\u0628 \u0628\u0627\u0632\u0633\u0627\u0632\u06cc cache \u0646\u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u062a\u0623\u06cc\u06cc\u062f HTTPS \u062f\u0648\u0628\u0627\u0631\u0647 \u0644\u0627\u0632\u0645 \u0627\u0633\u062a.\n- \u0627\u06af\u0631 \u0645\u0634\u062e\u0635\u0627\u062a DNS \u0647\u0646\u06af\u0627\u0645 \u062a\u063a\u06cc\u06cc\u0631/\u0628\u0631\u06af\u0634\u062a \u0634\u0628\u06a9\u0647 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0646\u0628\u0627\u0634\u0646\u062f\u060c \u0631\u0633\u06cc\u062f\u0646 \u062f\u06cc\u0631\u062a\u0631 \u0622\u0646\u200c\u0647\u0627 \u00ab\u0627\u0648\u0644\u06cc\u0646 baseline \u0628\u06cc\u200c\u0627\u062b\u0631\u00bb \u062d\u0633\u0627\u0628 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0646\u0633\u0644 resolver \u062f\u0648\u0628\u0627\u0631\u0647 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0647\u0633\u062a\u0647\u200c\u0627\u06cc \u06a9\u0647 \u062f\u0631 \u0641\u0627\u0635\u0644\u0647\u0654 \u0646\u0627\u0645\u0634\u062e\u0635 \u0633\u0627\u062e\u062a\u0647 \u0634\u062f\u0647\u060c \u0646\u062a\u0648\u0627\u0646\u062f \u0628\u0631\u0627\u06cc \u0633\u06cc\u0627\u0633\u062a \u062c\u062f\u06cc\u062f \u062a\u0623\u06cc\u06cc\u062f \u0635\u0627\u062f\u0631 \u06a9\u0646\u062f. \u0627\u06cc\u0646 \u0645\u062d\u0627\u0641\u0638 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u06cc\u06a9 \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0627\u0636\u0627\u0641\u06cc \u0627\u06cc\u062c\u0627\u062f \u06a9\u0646\u062f\u061b \u0627\u062f\u0639\u0627\u06cc \u0642\u0637\u0639\u200c\u0646\u0634\u062f\u0646 \u0646\u06cc\u0633\u062a.\n- \u0647\u0648\u06cc\u062a resolver \u0628\u0647\u200c\u0635\u0648\u0631\u062a snapshot \u062c\u062f\u0627\u0634\u062f\u0647 \u0648 \u0633\u0627\u062e\u062a\u0627\u0631\u06cc\u0627\u0641\u062a\u0647 \u0646\u06af\u0647 \u062f\u0627\u0634\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0646\u0628\u0648\u062f \u062f\u0627\u0645\u0646\u0647 \u0628\u0627 \u0631\u0634\u062a\u0647\u0654 \u0648\u0627\u0642\u0639\u06cc `null` \u06cc\u06a9\u06cc \u0646\u06cc\u0633\u062a\u061b \u062a\u0631\u062a\u06cc\u0628 DNS\u0647\u0627 \u0648 scope IPv6 \u062d\u0641\u0638 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0646\u0627\u0645 \u0646\u0645\u0627\u06cc\u0634\u06cc InetAddress \u0647\u0648\u06cc\u062a IP \u0631\u0627 \u0639\u0648\u0636 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u0645\u0634\u062e\u0635\u0627\u062a \u0641\u0642\u0637 \u062f\u0631 \u062d\u0627\u0641\u0638\u0647\u200c\u0627\u0646\u062f \u0648 \u0646\u0645\u0627\u06cc\u0634 \u0645\u062a\u0646\u06cc \u0627\u06cc\u0646 \u0634\u06cc\u0621 redacted \u0627\u0633\u062a.\n- \u0634\u0631\u0648\u0637 HTTPS\u060c \u0633\u0646 \u0645\u062f\u0631\u06a9 \u0634\u0627\u0645\u0644 \u062e\u0648\u0627\u0628\u060c \u0645\u0646\u0628\u0639 \u0641\u0639\u0627\u0644\u060c \u062d\u0630\u0641 \u0645\u06a9\u062b 300ms \u0648 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0638\u0631\u0641\u06cc\u062a native \u062a\u0627 \u062e\u0631\u0648\u062c \u0648\u0627\u0642\u0639\u06cc \u062d\u0641\u0638 \u0634\u062f\u0647\u200c\u0627\u0646\u062f. \u0646\u0648\u0633\u0627\u0646 \u06af\u0630\u0631\u0627\u06cc \u0627\u0639\u062a\u0628\u0627\u0631\u0633\u0646\u062c\u06cc Private DNS \u0628\u0647\u200c\u062a\u0646\u0647\u0627\u06cc\u06cc \u0647\u0648\u06cc\u062a resolver \u0631\u0627 \u0639\u0648\u0636 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f.\n\n## \u0645\u0631\u0632 \u0627\u06cc\u0646 \u0645\u0631\u062d\u0644\u0647\n\n\u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 flush \u062f\u0631\u062c\u0627\u060c \u0627\u0646\u062a\u0642\u0627\u0644 TTL/cache \u0628\u06cc\u0646 \u0645\u0648\u062a\u0648\u0631\u0647\u0627\u06cc \u0645\u062a\u0641\u0627\u0648\u062a \u06cc\u0627 \u0632\u0645\u0627\u0646\u200c\u0633\u0646\u062c\u06cc \u0645\u0633\u062a\u0642\u0644 DNS \u0631\u0627 \u067e\u06cc\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u0647\u06cc\u0686 \u06a9\u0646\u062a\u0631\u0644\u0631 \u0639\u0645\u0648\u0645\u06cc \u06cc\u0627 endpoint \u062c\u062f\u06cc\u062f\u06cc \u0641\u0639\u0627\u0644 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a. \u0628\u0627\u0632\u0633\u0627\u0632\u06cc \u0627\u0645\u0646 \u0647\u0633\u062a\u0647 \u0628\u0631\u0627\u06cc \u062a\u063a\u06cc\u06cc\u0631 \u0633\u06cc\u0627\u0633\u062a \u0634\u0646\u0627\u062e\u062a\u0647\u200c\u0634\u062f\u0647 \u062d\u0641\u0638 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0633\u0648\u06a9\u062a\u200c\u0647\u0627\u06cc \u0628\u0627\u0632 \u0631\u0627 \u0642\u0637\u0639 \u06a9\u0646\u062f.\n\n\u062f\u0631 Xray \u067e\u06cc\u0646\u200c\u0634\u062f\u0647\u060c \u0631\u0627\u0628\u0637 `features/dns.Client` \u0628\u0631\u0631\u0633\u06cc\u200c\u0634\u062f\u0647 LookupIP \u062f\u0627\u0631\u062f\u061b CacheCleanup \u0631\u06a9\u0648\u0631\u062f\u0647\u0627\u06cc \u0645\u0646\u0642\u0636\u06cc \u0631\u0627 \u067e\u0627\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 migration \u062f\u0627\u062e\u0644\u06cc \u062f\u0631 \u0647\u0645\u0627\u0646 \u06a9\u0646\u062a\u0631\u0644\u0631\u060c \u0642\u0631\u0627\u0631\u062f\u0627\u062f \u0627\u0646\u062a\u0642\u0627\u0644 cache \u0628\u06cc\u0646 \u0647\u0633\u062a\u0647\u200c\u0647\u0627 \u0646\u06cc\u0633\u062a. patch \u0645\u0639\u062a\u0628\u0631 \u0628\u0631\u0627\u06cc \u0647\u0645\u0647\u0654 \u0644\u0627\u06cc\u0647\u200c\u0647\u0627 \u0648 \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0628\u0627\u0632\u06af\u0634\u062a \u067e\u0627\u0633\u062e \u062f\u0631\u062d\u0627\u0644\u200c\u067e\u0631\u0648\u0627\u0632 \u0647\u0646\u0648\u0632 \u0644\u0627\u0632\u0645 \u0627\u0633\u062a. \u062c\u0632\u0626\u06cc\u0627\u062a \u062f\u0631 `docs/audit/DNS-CACHE-BOUNDARY-fa.md` \u0627\u0633\u062a.\n\n\u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc callback \u0648 snapshot \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632\u06cc \u0646\u0631\u0645\u200c\u0627\u0641\u0632\u0627\u0631\u06cc\u200c\u0627\u0646\u062f\u061b \u062a\u0633\u062a \u06af\u0648\u0634\u06cc\u060c \u067e\u0646\u0644 \u062e\u0635\u0648\u0635\u06cc\u060c \u0646\u0634\u062a DNS/IPv6\u060c \u0628\u0627\u062a\u0631\u06cc\u060c Doze\u060c handover \u0648 \u0646\u0635\u0628 \u06a9\u0627\u0631\u0628\u0631 NOT_RUN \u0627\u0633\u062a. \u062a\u063a\u06cc\u06cc\u0631 \u0645\u0639\u0646\u0627\u06cc DNS \u0628\u062f\u0648\u0646 \u062a\u063a\u06cc\u06cc\u0631 \u0642\u0627\u0628\u0644 \u0645\u0634\u0627\u0647\u062f\u0647\u0654 \u0633\u06cc\u0633\u062a\u0645 \u0644\u0632\u0648\u0645\u0627\u064b \u0642\u0627\u0628\u0644 \u062a\u0634\u062e\u06cc\u0635 \u0646\u06cc\u0633\u062a. \u0627\u0648\u0644\u06cc\u0646 \u067e\u0627\u0633\u062e \u0645\u0633\u062a\u0642\u0644 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u06cc\u0632 \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0646\u0634\u062f\u0647 \u0627\u0633\u062a.\n\n\u067e\u06cc\u0634 \u0627\u0632 \u0627\u0631\u062a\u0642\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0645\u0632\u062f\u0627\u0631 \u0628\u06af\u06cc\u0631\u06cc\u062f\u061b \u0628\u0631\u0646\u0627\u0645\u0647 \u0648 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0631\u0627 \u062d\u0630\u0641 \u0646\u06a9\u0646\u06cc\u062f.\n\n## \u0634\u0648\u0627\u0647\u062f \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631\n\n- commit \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647: `67187e7772bd67d8d2e41d740fa1838bf99ff49d`. \u0633\u0627\u062e\u062a \u0648 \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc \u0648\u0627\u062d\u062f \u0627\u0646\u062f\u0631\u0648\u06cc\u062f\u060c R8/lint\u060c \u0647\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0648 \u0622\u0631\u0634\u06cc\u0648/\u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0648\u06cc SDK29/34 \u0648 \u0628\u0631\u0631\u0633\u06cc metadata \u0647\u0631 \u0633\u0647 upstream \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f.\n- \u0645\u0633\u06cc\u0631 APK \u0628\u062f\u0648\u0646 \u0627\u0645\u0636\u0627\u060c \u06a9\u0646\u062a\u0631\u0644 tree/hash \u0648 \u0627\u0645\u0636\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0628\u0627 \u06a9\u0644\u06cc\u062f \u062f\u0627\u0626\u0645\u06cc \u0631\u0648\u06cc runner \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0645\u0648\u0641\u0642 \u0634\u062f. guard \u0639\u0627\u062f\u06cc \u0628\u062f\u0648\u0646 \u06a9\u0644\u06cc\u062f \u0647\u0645\u0686\u0646\u0627\u0646 \u0634\u06a9\u0633\u062a \u0645\u06cc\u200c\u062e\u0648\u0631\u062f\u061b \u0641\u0642\u0637 \u0646\u0627\u0645\u0632\u062f \u0635\u0631\u06cc\u062d\u0650 \u0628\u062f\u0648\u0646 \u0627\u0645\u0636\u0627 \u0627\u0633\u062a\u062b\u0646\u0627\u0633\u062a.\n- 36 \u062a\u0633\u062a Python \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 audit \u0645\u06cc\u0632\u0628\u0627\u0646 \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f. \u062e\u0631\u0648\u062c\u06cc \u062a\u0641\u0635\u06cc\u0644\u06cc workflow\u0647\u0627 \u062f\u0631 JSON\u0647\u0627\u06cc \u06a9\u0646\u0627\u0631 \u0647\u0645\u06cc\u0646 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u062b\u0628\u062a \u0634\u062f\u0647 \u0627\u0633\u062a.\n- \u0622\u0632\u0645\u0648\u0646 \u06af\u0648\u0634\u06cc \u0648 \u0634\u0628\u06a9\u0647\u0654 \u062e\u0635\u0648\u0635\u06cc NOT_RUN \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u062f. \u0646\u062a\u06cc\u062c\u0647\u0654 \u0628\u0631\u0631\u0633\u06cc \u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f.\n"
}
