  "tarball_url": "https://api.github.com/repos/hojjatrad/parvaz/tarball/v1.27.0",
  "zipball_url": "https://api.github.com/repos/hojjatrad/parvaz/zipball/v1.27.0",
  "body": "# Parvaz 1.27.0 \u2014 \u06a9\u06cc\u0641\u06cc\u062a \u062a\u0637\u0628\u06cc\u0642\u06cc \u0648 \u0628\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647\u0654 \u0647\u0633\u062a\u0647\u200c\u0647\u0627\n\nversionCode 33\u061b \u0628\u0633\u062a\u0647 \u0648 \u06a9\u0644\u06cc\u062f \u0627\u0645\u0636\u0627\u06cc \u062f\u0627\u0626\u0645\u06cc \u062a\u063a\u06cc\u06cc\u0631 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u0646\u0633\u062e\u0647\u200c\u0647\u0627\u06cc \u0642\u0628\u0644\u06cc \u0628\u0627\u0632\u0646\u0648\u06cc\u0633\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f.\n\n## \u067e\u0627\u06cc\u062f\u0627\u0631\u06cc \u0648 \u0627\u0646\u062a\u062e\u0627\u0628 \u0633\u0631\u0648\u0631\n\n- \u067e\u0627\u0633\u062e\u0650 \u06a9\u0646\u062f\u060c \u0642\u0637\u0639\u06cc \u0645\u062d\u0633\u0648\u0628 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u062e\u0631\u0627\u0628\u06cc \u0628\u0627\u06cc\u062f \u0686\u0646\u062f \u0628\u0627\u0631 \u0628\u0627 HTTPS \u0627\u0632 \u0645\u0633\u06cc\u0631 \u062a\u0623\u06cc\u06cc\u062f\u0634\u062f\u0647 \u0628\u0631\u0631\u0633\u06cc \u0634\u0648\u062f. \u0648\u0636\u0639\u06cc\u062a \u0633\u0628\u0632 \u067e\u0633 \u0627\u0632 \u062e\u0631\u0627\u0628\u06cc \u062a\u0623\u06cc\u06cc\u062f\u0634\u062f\u0647 \u067e\u0633 \u06af\u0631\u0641\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0628\u0627 \u067e\u0627\u0633\u062e \u0645\u0639\u062a\u0628\u0631 \u0647\u0645\u0627\u0646 \u0646\u0634\u0633\u062a \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0627\u0633\u062a.\n- \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0628\u0627 \u0645\u0648\u062a\u0648\u0631 \u0648\u0627\u0642\u0639\u06cc \u0648 \u062f\u0648 \u067e\u0627\u0633\u062e \u0645\u0639\u062a\u0628\u0631 \u0622\u0632\u0645\u0627\u06cc\u0634 \u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u062d\u062f\u0627\u06a9\u062b\u0631 \u062f\u0648 \u0646\u0627\u0645\u0632\u062f \u062e\u0648\u062f\u06a9\u0627\u0631\u060c \u0633\u0642\u0641 \u0639\u0645\u0648\u0645\u06cc \u0633\u0647 \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0648 \u0634\u0634 worker \u0634\u0628\u06a9\u0647\u0654 \u0632\u0646\u062f\u0647. \u067e\u0646\u062c\u0631\u0647\u0654 \u0645\u0642\u0627\u06cc\u0633\u0647\u0654 \u06a9\u0648\u062a\u0627\u0647\u060c \u0633\u0627\u0628\u0642\u0647\u0654 \u0645\u062d\u0644\u06cc \u0648 \u0646\u0648\u0633\u0627\u0646 \u062f\u0631 \u0627\u0645\u062a\u06cc\u0627\u0632 \u0644\u062d\u0627\u0638 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0627\u0648\u0644\u06cc\u0646 \u067e\u0627\u0633\u062e \u0628\u0647\u200c\u062a\u0646\u0647\u0627\u06cc\u06cc \u0628\u0631\u0646\u062f\u0647 \u0646\u06cc\u0633\u062a.\n- \u062a\u0639\u0648\u06cc\u0636 \u0635\u0631\u0641\u0627\u064b \u0628\u0631\u0627\u06cc \u06a9\u06cc\u0641\u06cc\u062a \u0628\u0647 \u062d\u062f\u0627\u0642\u0644 25\u066a \u0648 100ms \u0628\u0647\u0628\u0648\u062f\u060c \u0686\u0646\u062f \u0645\u0634\u0627\u0647\u062f\u0647\u060c \u0639\u0645\u0631 \u06a9\u0627\u0641\u06cc \u0627\u062a\u0635\u0627\u0644 \u0648 \u0641\u0627\u0635\u0644\u0647\u0654 \u067e\u0646\u062c\u200c\u062f\u0642\u06cc\u0642\u0647\u200c\u0627\u06cc \u0646\u06cc\u0627\u0632 \u062f\u0627\u0631\u062f. \u0647\u0646\u06af\u0627\u0645 \u062a\u0631\u0627\u0641\u06cc\u06a9 \u0645\u0634\u0627\u0647\u062f\u0647\u200c\u0634\u062f\u0647\u060c \u062c\u0633\u062a\u062c\u0648\u06cc \u06a9\u06cc\u0641\u06cc\u062a\u06cc \u0639\u0642\u0628 \u0645\u06cc\u200c\u0627\u0641\u062a\u062f. \u0646\u0627\u0645\u0632\u062f\u0647\u0627\u06cc \u0646\u0627\u0645\u0648\u0641\u0642 \u0648\u0627\u0642\u0639\u06cc cooldown \u0645\u06cc\u200c\u06af\u06cc\u0631\u0646\u062f\u061b \u0645\u0648\u0627\u0631\u062f \u062a\u0633\u062a\u200c\u0646\u0634\u062f\u0647/\u0644\u063a\u0648\u0634\u062f\u0647/\u0645\u0628\u0647\u0645 \u0634\u06a9\u0633\u062a \u0633\u0631\u0648\u0631 \u062d\u0633\u0627\u0628 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u067e\u0633 \u0627\u0632 \u062f\u0648\u0631 \u0628\u06cc\u200c\u0646\u062a\u06cc\u062c\u0647\u0654 \u0645\u0628\u0647\u0645\u060c \u062a\u0631\u062a\u06cc\u0628 \u0628\u0631\u0631\u0633\u06cc \u0645\u0648\u0642\u062a\u0627\u064b \u0645\u06cc\u200c\u0686\u0631\u062e\u062f \u062a\u0627 \u0633\u0627\u06cc\u0631 \u0646\u0627\u0645\u0632\u062f\u0647\u0627 \u0647\u0645 \u0646\u0648\u0628\u062a \u0628\u06af\u06cc\u0631\u0646\u062f.\n- \u0646\u06cc\u0627\u0641\u062a\u0646 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u060c \u062a\u0648\u0646\u0644 \u0642\u0627\u0628\u0644 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0631\u0627 \u0628\u06cc\u200c\u062f\u0644\u06cc\u0644 \u0645\u062a\u0648\u0642\u0641 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u062a\u0644\u0627\u0634\u200c\u0647\u0627\u06cc \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0628\u0627 \u0641\u0627\u0635\u0644\u0647\u0654 30 \u062b\u0627\u0646\u06cc\u0647 \u062a\u0627 \u067e\u0646\u062c \u062f\u0642\u06cc\u0642\u0647 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u062a\u0646\u0647\u0627 \u0645\u0646\u0628\u0639 \u0641\u0639\u0627\u0644\u060c \u0628\u0627 fingerprint \u0641\u0639\u0644\u06cc\u060c \u0645\u062c\u0627\u0632 \u0627\u0633\u062a.\n- \u062a\u063a\u06cc\u06cc\u0631 \u0634\u0628\u06a9\u0647 \u0627\u0628\u062a\u062f\u0627 \u0631\u0648\u06cc \u0627\u062a\u0635\u0627\u0644 \u0632\u0646\u062f\u0647 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u0627\u06af\u0631 \u0647\u0646\u0648\u0632 \u067e\u0627\u0633\u062e \u0645\u06cc\u200c\u062f\u0647\u062f\u060c \u0647\u0633\u062a\u0647 \u0648 cache \u0622\u0646 \u062d\u0641\u0638 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u062f\u0631 \u063a\u06cc\u0631 \u0627\u06cc\u0646 \u0635\u0648\u0631\u062a reconnect \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u0646\u062a\u0642\u0627\u0644 cache \u0628\u06cc\u0646 \u062f\u0648 \u0646\u0645\u0648\u0646\u0647\u0654 native \u067e\u06cc\u0627\u062f\u0647 \u0646\u0634\u062f\u0647 \u0648 \u0627\u0646\u062a\u0638\u0627\u0631 300ms \u062d\u0630\u0641 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a.\n- \u0645\u0646\u0627\u0628\u0639 \u0645\u0648\u062a\u0648\u0631 \u062e\u0627\u0631\u062c\u06cc \u0648 \u0638\u0631\u0641\u06cc\u062a \u0622\u0646 \u062a\u0646\u0647\u0627 \u067e\u0633 \u0627\u0632 \u062e\u0631\u0648\u062c \u0648\u0627\u0642\u0639\u06cc \u0641\u0631\u0627\u06cc\u0646\u062f \u0622\u0632\u0627\u062f \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0627\u0646\u062a\u0638\u0627\u0631 \u062e\u0631\u0648\u062c \u0628\u0647 reaper \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u0645\u0646\u062a\u0642\u0644 \u0634\u062f\u0647 \u0627\u0633\u062a. \u062d\u0630\u0641 \u0647\u0645\u0647\u0654 ANR\u0647\u0627 \u06cc\u0627 \u0642\u0637\u0639\u200c\u0646\u0634\u062f\u0646 \u0647\u0645\u0647\u0654 \u0646\u0634\u0633\u062a\u200c\u0647\u0627 \u0627\u062f\u0639\u0627 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.\n\n## \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0647\u0631 \u0633\u0647 \u0647\u0633\u062a\u0647\n\n\u067e\u0627\u06cc\u0634 \u0646\u0633\u062e\u0647\u200c\u0647\u0627\u06cc stable \u0631\u0633\u0645\u06cc Xray/AndroidLibXrayLite\u060c sing-box \u0648 Mihomo \u0647\u0631 \u0634\u0634 \u0633\u0627\u0639\u062a \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0646\u0633\u062e\u0647\u0654 \u062c\u062f\u06cc\u062f \u0641\u0642\u0637 \u067e\u0633 \u0627\u0632 \u06a9\u0646\u062a\u0631\u0644 commit/hash\u060c \u0633\u0627\u062e\u062a \u0648 \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627 \u0642\u0627\u0628\u0644 \u0627\u0646\u062a\u0634\u0627\u0631 \u0627\u0633\u062a. native TCP/UDP/TLS\u060c \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632 Android 10/14\u060c \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc \u0648\u0627\u062d\u062f\u060c lint \u0648 \u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc \u062f\u0631 \u0645\u0631\u062d\u0644\u0647\u0654 \u0628\u062f\u0648\u0646 \u06a9\u0644\u06cc\u062f \u0627\u0645\u0636\u0627 \u0627\u062c\u0631\u0627 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f.\n\n\u0627\u0645\u0636\u0627\u06cc APK \u0622\u0645\u0627\u062f\u0647 \u0631\u0648\u06cc runner \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u0628\u0627\u06cc\u0646\u0631\u06cc \u0646\u0627\u0645\u0632\u062f \u0648 Gradle \u0631\u0648\u06cc runner \u0627\u0645\u0636\u0627\u06a9\u0646\u0646\u062f\u0647 \u0627\u062c\u0631\u0627 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f. metadata \u0645\u0633\u062a\u0642\u0644\u0627\u064b \u0628\u0627\u0632\u062a\u0648\u0644\u06cc\u062f\u060c tree \u0633\u0648\u0631\u0633 \u0628\u0627 \u0646\u0627\u0645\u0632\u062f \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647 \u062a\u0637\u0628\u06cc\u0642\u060c \u0627\u0645\u0636\u0627/\u0628\u0633\u062a\u0647/\u0646\u0633\u062e\u0647/ABI \u0628\u0631\u0631\u0633\u06cc\u060c \u0648 rollback \u0647\u0631 \u0633\u0647 \u0647\u0633\u062a\u0647 \u0631\u062f \u0645\u06cc\u200c\u0634\u0648\u062f. source \u0645\u062a\u0646\u0627\u0638\u0631 \u0647\u0645\u0631\u0627\u0647 \u0627\u0646\u062a\u0634\u0627\u0631 \u0627\u0633\u062a\u061b \u062e\u0637\u0627\u06cc \u062a\u0633\u062a/\u0633\u0627\u062e\u062a/\u0645\u062c\u0648\u0632 GitHub \u0645\u0627\u0646\u0639 \u0627\u0646\u062a\u0634\u0627\u0631 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0628\u0631\u0646\u0627\u0645\u0647\u0654 \u0632\u0645\u0627\u0646\u06cc GitHub \u062a\u0636\u0645\u06cc\u0646 \u0627\u062c\u0631\u0627\u06cc \u0644\u062d\u0638\u0647\u200c\u0627\u06cc \u0646\u06cc\u0633\u062a.\n\n## \u0628\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u062f\u0627\u062e\u0644 \u0628\u0631\u0646\u0627\u0645\u0647\n\n\u062f\u0648 \u06a9\u0646\u062a\u0631\u0644 \u062f\u0631 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0636\u0627\u0641\u0647 \u0634\u062f\u0647: \u0628\u0631\u0631\u0633\u06cc \u062e\u0648\u062f\u06a9\u0627\u0631 \u0648 \u062f\u0627\u0646\u0644\u0648\u062f \u062e\u0648\u062f\u06a9\u0627\u0631 \u0631\u0648\u06cc \u0634\u0628\u06a9\u0647\u0654 unmetered \u0647\u0646\u06af\u0627\u0645 \u0634\u0627\u0631\u0698. \u0628\u0631\u0631\u0633\u06cc \u062a\u0642\u0631\u06cc\u0628\u0627\u064b \u0647\u0631 \u0634\u0634 \u0633\u0627\u0639\u062a \u0627\u0633\u062a\u061b \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f\u06cc \u062a\u0627\u0628\u0639 \u0627\u0646\u062f\u0631\u0648\u06cc\u062f/Doze \u0627\u0633\u062a. \u062f\u0627\u0646\u0644\u0648\u062f \u0628\u0627 \u0641\u0636\u0627\u06cc \u06a9\u0627\u0641\u06cc\u060c \u0628\u0631\u0631\u0633\u06cc \u0647\u0634/\u0628\u0633\u062a\u0647/\u0646\u0633\u062e\u0647/\u0627\u0645\u0636\u0627 \u0648 \u0627\u062f\u0627\u0645\u0647\u0654 \u062f\u0627\u0646\u0644\u0648\u062f \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0627\u0639\u0644\u0627\u0646 \u0641\u0642\u0637 \u0631\u0627\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u0627\u0633\u062a\u061b **\u0646\u0635\u0628 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u0627\u0642\u062f\u0627\u0645 \u0648 \u062a\u0623\u06cc\u06cc\u062f \u06a9\u0627\u0631\u0628\u0631 \u062f\u0627\u0631\u062f**. \u0634\u0628\u06a9\u0647\u0654 unmetered \u0645\u0639\u0645\u0648\u0644\u0627\u064b Wi-Fi \u0627\u0633\u062a\u060c \u0646\u0647 \u062a\u0636\u0645\u06cc\u0646 \u0631\u0627\u06cc\u06af\u0627\u0646\u200c\u0628\u0648\u062f\u0646 \u0627\u06cc\u0646\u062a\u0631\u0646\u062a \u0627\u0632 \u0637\u0631\u0641 \u0627\u067e\u0631\u0627\u062a\u0648\u0631.\n\n\u0628\u0631\u0631\u0633\u06cc \u062f\u0627\u0646\u0644\u0648\u062f \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647 \u062f\u06cc\u06af\u0631 \u0642\u0641\u0644 \u0645\u0634\u062a\u0631\u06a9 \u0628\u0627 \u062f\u0631\u062e\u0648\u0627\u0633\u062a metadata \u0631\u0627\u0628\u0637 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0646\u062f\u0627\u0631\u062f\u061b \u0627\u0646\u062a\u0638\u0627\u0631 \u062f\u0627\u0646\u0644\u0648\u062f \u0642\u0627\u0628\u0644 interrupt \u0627\u0633\u062a. \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u0645\u0648\u0641\u0642 worker \u0646\u06cc\u0632 \u0634\u06a9\u0633\u062a \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u0635\u0641\u062d\u0647\u0654 \u0627\u0635\u0644\u06cc \u0645\u062d\u0633\u0648\u0628 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.\n\n## \u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627 \u0648 \u0627\u0631\u062a\u0642\u0627\n\n\u062a\u0633\u062a \u06af\u0648\u0634\u06cc \u0648\u0627\u0642\u0639\u06cc\u060c \u0634\u0628\u06a9\u0647\u0654 \u062e\u0635\u0648\u0635\u06cc\u060c \u0646\u0634\u062a\u060c DNS/IPv6\u060c Doze\u060c handover \u0648 \u0628\u0627\u062a\u0631\u06cc \u0647\u0645\u0686\u0646\u0627\u0646 NOT_RUN \u0627\u0633\u062a. CI \u062c\u0627\u06cc \u0627\u06cc\u0646 \u0622\u0632\u0645\u0627\u06cc\u0634\u200c\u0647\u0627 \u0631\u0627 \u0646\u0645\u06cc\u200c\u06af\u06cc\u0631\u062f. \u0633\u0631\u0639\u062a \u0648 \u0642\u0637\u0639\u200c\u0646\u0634\u062f\u0646 \u0645\u0637\u0644\u0642 \u062a\u0636\u0645\u06cc\u0646 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u06a9\u0627\u0646\u0641\u06cc\u06af \u0686\u0646\u062f\u0645\u0633\u06cc\u0631\u0647\u0654 \u0645\u0628\u0647\u0645 \u0628\u062f\u0648\u0646 \u0645\u062f\u0631\u06a9 \u0633\u0628\u0632 \u06cc\u0627 \u0628\u0631\u0646\u062f\u0647 \u0627\u0639\u0644\u0627\u0645 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. DNS \u0645\u0633\u062a\u0642\u0644\u060c \u0627\u0646\u062a\u0642\u0627\u0644 TTL cache \u0648 \u062a\u0645\u0627\u0645 \u0628\u0647\u06cc\u0646\u0647\u200c\u0633\u0627\u0632\u06cc\u200c\u0647\u0627\u06cc native \u062a\u06a9\u0645\u06cc\u0644 \u0646\u0634\u062f\u0647\u200c\u0627\u0646\u062f.\n\n\u067e\u06cc\u0634 \u0627\u0632 \u0627\u0631\u062a\u0642\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc\u200c\u0634\u062f\u0647 \u0628\u06af\u06cc\u0631\u06cc\u062f\u061b \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u062d\u0630\u0641 \u0648 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0631\u0627 \u067e\u0627\u06a9 \u0646\u06a9\u0646\u06cc\u062f. \u0647\u0645\u06cc\u0646 \u0627\u0645\u0636\u0627\u06cc \u062f\u0627\u0626\u0645\u06cc \u0628\u0631\u0627\u06cc \u0627\u0631\u062a\u0642\u0627 \u062d\u0641\u0638 \u0645\u06cc\u200c\u0634\u0648\u062f.\n\n## \u0634\u0648\u0627\u0647\u062f \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631\n\n- commit \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647: `ca08a5f43fc632b68b71b805095d904687ba4d07`. \u0633\u0627\u062e\u062a \u0648 \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc \u0648\u0627\u062d\u062f \u0627\u0646\u062f\u0631\u0648\u06cc\u062f\u060c R8/lint\u060c \u0647\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0648 \u0622\u0631\u0634\u06cc\u0648/\u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0648\u06cc SDK29/34 \u0648 \u0628\u0631\u0631\u0633\u06cc metadata \u0647\u0631 \u0633\u0647 upstream \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f.\n- \u0645\u0633\u06cc\u0631 APK \u0628\u062f\u0648\u0646 \u0627\u0645\u0636\u0627\u060c \u06a9\u0646\u062a\u0631\u0644 tree/hash \u0648 \u0627\u0645\u0636\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0628\u0627 \u06a9\u0644\u06cc\u062f \u062f\u0627\u0626\u0645\u06cc \u0631\u0648\u06cc runner \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0645\u0648\u0641\u0642 \u0634\u062f. guard \u0639\u0627\u062f\u06cc \u0628\u062f\u0648\u0646 \u06a9\u0644\u06cc\u062f \u0647\u0645\u0686\u0646\u0627\u0646 \u0634\u06a9\u0633\u062a \u0645\u06cc\u200c\u062e\u0648\u0631\u062f\u061b \u0641\u0642\u0637 \u0646\u0627\u0645\u0632\u062f \u0635\u0631\u06cc\u062d\u0650 \u0628\u062f\u0648\u0646 \u0627\u0645\u0636\u0627 \u0627\u0633\u062a\u062b\u0646\u0627\u0633\u062a.\n- 36 \u062a\u0633\u062a Python \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 audit \u0645\u06cc\u0632\u0628\u0627\u0646 \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f. \u062e\u0631\u0648\u062c\u06cc \u062a\u0641\u0635\u06cc\u0644\u06cc workflow\u0647\u0627 \u062f\u0631 JSON\u0647\u0627\u06cc \u06a9\u0646\u0627\u0631 \u0647\u0645\u06cc\u0646 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u062b\u0628\u062a \u0634\u062f\u0647 \u0627\u0633\u062a.\n- \u0622\u0632\u0645\u0648\u0646 \u06af\u0648\u0634\u06cc \u0648 \u0634\u0628\u06a9\u0647\u0654 \u062e\u0635\u0648\u0635\u06cc NOT_RUN \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u062f. \u0646\u062a\u06cc\u062c\u0647\u0654 \u0628\u0631\u0631\u0633\u06cc \u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f.\n"
}
