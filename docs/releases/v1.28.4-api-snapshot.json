  "tarball_url": "https://api.github.com/repos/hojjatrad/parvaz/tarball/v1.28.4",
  "zipball_url": "https://api.github.com/repos/hojjatrad/parvaz/zipball/v1.28.4",
  "body": "# \u067e\u0631\u0648\u0627\u0632 \u06f1.\u06f2\u06f8.\u06f4 \u2014 \u0646\u0645\u0627\u06cc\u0634 \u062a\u0623\u062e\u06cc\u0631 \u0627\u062a\u0635\u0627\u0644 \u0641\u0639\u0627\u0644\n\n- \u067e\u0627\u0633\u062e HTTPS \u0627\u0648\u0644\u06cc\u0647 \u067e\u06cc\u0634\u200c\u062a\u0631 \u0641\u0642\u0637 \u0648\u0636\u0639\u06cc\u062a \u062a\u0623\u06cc\u06cc\u062f \u0627\u062a\u0635\u0627\u0644 \u0631\u0627 \u062a\u063a\u06cc\u06cc\u0631 \u0645\u06cc\u200c\u062f\u0627\u062f \u0648 \u0628\u0647 \u0631\u062f\u06cc\u0641 \u0641\u0647\u0631\u0633\u062a \u0646\u0645\u06cc\u200c\u0631\u0633\u06cc\u062f. \u0627\u06a9\u0646\u0648\u0646 \u062a\u06cc\u06a9 \u0645\u0648\u062c\u0648\u062f \u0622\u0645\u0627\u0631 \u0647\u0645\u0627\u0646 \u067e\u0627\u0633\u062e \u0645\u0639\u062a\u0628\u0631 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0631\u062f\u06cc\u0641 \u062a\u0633\u062a\u200c\u0646\u0634\u062f\u0647\u0654 \u0627\u062a\u0635\u0627\u0644 \u0641\u0639\u0627\u0644 \u0646\u0645\u0627\u06cc\u0634 \u0648 \u0630\u062e\u06cc\u0631\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u0628\u062f\u0648\u0646 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0628\u06a9\u0647\u060c \u0647\u0633\u062a\u0647 \u06cc\u0627 \u062a\u0627\u06cc\u0645\u0631 \u0627\u0636\u0627\u0641\u06cc.\n- \u0646\u062a\u06cc\u062c\u0647 \u0641\u0642\u0637 \u0645\u062a\u0639\u0644\u0642 \u0628\u0647 \u0647\u0645\u0627\u0646 \u0646\u0634\u0633\u062a\u060c \u0645\u0646\u0628\u0639\u060c \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u0648 \u0634\u0628\u06a9\u0647 \u0648 \u062f\u0631 \u0645\u062f\u062a \u0627\u0639\u062a\u0628\u0627\u0631 \u0645\u062f\u0631\u06a9 \u067e\u0630\u06cc\u0631\u0641\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062a\u0633\u062a \u062f\u0633\u062a\u06cc \u0648 \u0648\u0636\u0639\u06cc\u062a/\u0646\u062a\u06cc\u062c\u0647\u0654 \u0622\u0646 \u0628\u0627\u0632\u0646\u0648\u06cc\u0633\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u067e\u0627\u0633\u062e \u0646\u0627\u0645\u0648\u0641\u0642 \u0648 \u0634\u0645\u0627\u0631\u0646\u062f\u0647\u0654 \u062a\u0631\u0627\u0641\u06cc\u06a9 \u0639\u062f\u062f \u067e\u06cc\u0646\u06af \u0646\u0645\u06cc\u200c\u0633\u0627\u0632\u0646\u062f.\n- \u0647\u0646\u06af\u0627\u0645 \u062a\u0627\u0632\u0647\u200c\u0634\u062f\u0646 \u0627\u0634\u062a\u0631\u0627\u06a9\u060c \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u0631\u062f\u06cc\u0641 \u0627\u06a9\u0646\u0648\u0646 \u0628\u0647 \u0634\u06cc\u0621 \u0641\u0639\u0644\u06cc \u06a9\u0627\u0646\u06a9\u0634\u0646 \u0645\u062a\u0635\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f\u061b \u0635\u0631\u0641\u0627\u064b \u0631\u062f\u06cc\u0641 \u0642\u062f\u06cc\u0645\u06cc \u0631\u0627 \u062f\u0648\u0628\u0627\u0631\u0647 \u0631\u0633\u0645 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u0631\u062f\u06cc\u0641 \u062d\u0630\u0641/\u0628\u0627\u06cc\u06af\u0627\u0646\u06cc\u200c\u0634\u062f\u0647 \u0628\u0627\u0632\u06af\u0631\u062f\u0627\u0646\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f.\n\n\u062a\u0623\u062e\u06cc\u0631 \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 HTTPS \u0627\u0632 \u0645\u0633\u06cc\u0631 \u067e\u0631\u0648\u06a9\u0633\u06cc \u0627\u0633\u062a\u060c \u0646\u0647 ICMP \u06cc\u0627 \u0633\u0631\u0639\u062a \u062f\u0627\u0646\u0644\u0648\u062f. \u0627\u06cc\u0646 \u0646\u0645\u0627\u06cc\u0634 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0641\u0642\u0637 \u0628\u0631\u0627\u06cc \u0627\u062a\u0635\u0627\u0644 \u0641\u0639\u0627\u0644\u0650 \u062a\u0623\u06cc\u06cc\u062f\u0634\u062f\u0647 \u0627\u0633\u062a\u061b \u0628\u0631\u0627\u06cc \u0633\u0627\u06cc\u0631 \u06a9\u0627\u0646\u06a9\u0634\u0646\u200c\u0647\u0627 \u062a\u0633\u062a \u062a\u06a9\u06cc/\u06af\u0631\u0648\u0647\u06cc \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f. \u06a9\u0627\u0646\u0641\u06cc\u06af \u06a9\u0627\u0645\u0644\u0650 \u0645\u0628\u0647\u0645 \u0628\u062f\u0648\u0646 \u0645\u062f\u0631\u06a9\u060c \u0639\u062f\u062f \u0646\u0645\u06cc\u200c\u06af\u06cc\u0631\u062f. \u0622\u0632\u0645\u0648\u0646 \u0648\u0627\u0642\u0639\u06cc \u06af\u0648\u0634\u06cc\u060c \u0646\u0635\u0628\u060c \u0647\u0645\u0632\u06cc\u0633\u062a\u06cc probe \u0648 VPN \u0632\u0646\u062f\u0647\u060c \u0646\u0634\u062a/Doze/\u0628\u0627\u062a\u0631\u06cc \u0627\u0646\u062c\u0627\u0645 \u0646\u0634\u062f\u0647\u200c\u0627\u0646\u062f. \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a DNS \u0622\u0632\u0645\u0627\u06cc\u0634\u06af\u0627\u0647\u06cc \u0648\u0627\u0631\u062f \u0646\u0633\u062e\u0647 \u0646\u0634\u062f\u0647\u200c\u0627\u0646\u062f.\n\n\u06af\u06cc\u062a\u200c\u0647\u0627\u06cc \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 \u0627\u0645\u0636\u0627\u06cc \u062f\u0627\u0626\u0645\u06cc \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f\u061b \u0628\u0631\u0631\u0633\u06cc \u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 \u062c\u062f\u0627 \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f. \u0628\u0631\u0646\u0627\u0645\u0647 \u0648 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u062d\u0630\u0641 \u0646\u0634\u0648\u0646\u062f\u061b \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0631\u062a\u0642\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0645\u0632\u062f\u0627\u0631 \u0628\u06af\u06cc\u0631\u06cc\u062f.\n\n## \u0634\u0648\u0627\u0647\u062f \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631\n\n- commit \u0627\u062c\u0631\u0627\u06cc\u06cc \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647: `478529802b6b9b02897af0d4eebca20781a4cadf`.\n- 14 \u0627\u062c\u0631\u0627\u06cc CI \u0645\u0648\u0641\u0642\u061b 444 \u062a\u0633\u062a \u0648\u0627\u062d\u062f \u0628\u062f\u0648\u0646 failure/error/skip\u060c \u0627\u0632 \u062c\u0645\u0644\u0647 30 \u0627\u062c\u0631\u0627\u06cc \u062c\u062f\u06cc\u062f \u0628\u0631\u0627\u06cc \u0627\u0646\u062a\u0642\u0627\u0644 \u067e\u0627\u0633\u062e \u0627\u0648\u0644\u06cc\u0647 \u0628\u0647 \u0631\u062f\u06cc\u0641 \u0648 \u06a9\u0646\u062a\u0631\u0644 \u0645\u0627\u0644\u06a9\u06cc\u062a/\u0627\u0639\u062a\u0628\u0627\u0631 \u0622\u0646.\n- 15 \u0622\u0632\u0645\u0648\u0646 native \u0648 11 \u0622\u0632\u0645\u0648\u0646 \u0622\u0631\u0634\u06cc\u0648/\u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0648\u06cc \u0647\u0631 \u06cc\u06a9 \u0627\u0632 SDK29/34\u061b \u0627\u06cc\u0646\u200c\u0647\u0627 \u0622\u0632\u0645\u0648\u0646 \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632\u0646\u062f\u060c \u0646\u0647 \u06af\u0648\u0634\u06cc \u06a9\u0627\u0631\u0628\u0631.\n- R8/lint\u060c \u0628\u0633\u062a\u0647\u0654 \u0633\u0648\u0631\u0633 \u0648 metadata \u0631\u0633\u0645\u06cc \u0633\u0647 \u0647\u0633\u062a\u0647\u060c \u0627\u0645\u0636\u0627\u06cc APK \u0622\u0645\u0627\u062f\u0647 \u0631\u0648\u06cc runner \u062c\u062f\u0627 \u0628\u0627 \u06a9\u0644\u06cc\u062f \u062f\u0627\u0626\u0645\u06cc \u0648 36 \u0622\u0632\u0645\u0648\u0646 Python \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 audit \u0645\u06cc\u0632\u0628\u0627\u0646 \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f.\n- \u0622\u0632\u0645\u0627\u06cc\u0634 DNS \u0648\u0627\u0631\u062f \u0646\u0633\u062e\u0647 \u0646\u0634\u062f\u0647 \u0648 \u0622\u0632\u0645\u0648\u0646 \u0646\u0635\u0628/\u0639\u0645\u0644\u06a9\u0631\u062f \u06af\u0648\u0634\u06cc \u0648 \u0634\u0628\u06a9\u0647\u0654 \u062e\u0635\u0648\u0635\u06cc NOT_RUN \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u062f.\n"
}
