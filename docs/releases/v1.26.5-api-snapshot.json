  "tarball_url": "https://api.github.com/repos/hojjatrad/parvaz/tarball/v1.26.5",
  "zipball_url": "https://api.github.com/repos/hojjatrad/parvaz/zipball/v1.26.5",
  "body": "# Parvaz 1.26.5 (versionCode 32)\n\n## \u062a\u0623\u06cc\u06cc\u062f \u0648\u0627\u0642\u0639\u06cc \u0627\u0631\u062a\u0628\u0627\u0637 \u0633\u0631\u0648\u0631 \u0648 \u0631\u0641\u0639 \u0648\u0636\u0639\u06cc\u062a \u0646\u0627\u0631\u0646\u062c\u06cc\u0650 \u0645\u0627\u0646\u062f\u06af\u0627\u0631\n\n- \u0631\u0646\u06af \u0633\u0628\u0632 \u0641\u0642\u0637 \u067e\u0633 \u0627\u0632 \u067e\u0627\u0633\u062e \u0645\u0648\u0641\u0642 HTTPS \u0628\u0627 \u0627\u0639\u062a\u0628\u0627\u0631\u0633\u0646\u062c\u06cc \u067e\u06cc\u0634\u200c\u0641\u0631\u0636 \u06af\u0648\u0627\u0647\u06cc \u0648 \u0646\u0627\u0645 \u0645\u06cc\u0632\u0628\u0627\u0646\u060c \u0627\u0632 \u0645\u0633\u06cc\u0631 \u062a\u0623\u06cc\u06cc\u062f\u0634\u062f\u0647\u0654 \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u0641\u0639\u0627\u0644 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0631\u0648\u0634\u0646\u200c\u0634\u062f\u0646 \u0647\u0633\u062a\u0647\u060c \u0646\u0645\u0648\u062f\u0627\u0631\u060c RX\u060c \u067e\u06cc\u0646\u06af \u0628\u0648\u0645\u06cc \u06cc\u0627 \u067e\u0627\u0633\u062e \u0645\u0633\u06cc\u0631 DIRECT \u0645\u0639\u06cc\u0627\u0631 \u0633\u0628\u0632\u0634\u062f\u0646 \u0646\u06cc\u0633\u062a.\n- \u06cc\u06a9 \u0648\u0631\u0648\u062f\u06cc HTTP \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0631\u0648\u06cc loopback \u0648 \u067e\u0648\u0631\u062a \u0645\u0648\u0642\u062a\u0650 \u0647\u0645\u0627\u0646 \u0646\u0634\u0633\u062a\u060c \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0628\u0631\u0631\u0633\u06cc \u0631\u0627 \u067e\u06cc\u0634 \u0627\u0632 \u0642\u0648\u0627\u0639\u062f DIRECT \u0628\u0647 outbound \u0633\u0631\u0648\u0631 \u0627\u0646\u062a\u062e\u0627\u0628\u200c\u0634\u062f\u0647 \u0647\u062f\u0627\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0642\u0648\u0627\u0639\u062f \u0639\u0627\u062f\u06cc \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u060c \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0627\u0646\u062a\u0642\u0627\u0644\u060c \u0632\u0646\u062c\u06cc\u0631\u0647 \u0648 TLS \u062a\u063a\u06cc\u06cc\u0631 \u0646\u0645\u06cc\u200c\u06a9\u0646\u0646\u062f. \u062f\u0631 \u0647\u0633\u062a\u0647\u0654 \u062f\u0648\u0645\u060c \u0645\u0633\u06cc\u0631 \u062f\u0627\u062e\u0644\u06cc \u0646\u06cc\u0632 \u0628\u0627\u06cc\u062f \u0628\u062f\u0648\u0646 \u062e\u0631\u0648\u062c\u06cc \u0645\u0633\u062a\u0642\u06cc\u0645 \u0642\u0627\u0628\u0644 \u0627\u062b\u0628\u0627\u062a \u0628\u0627\u0634\u062f\u061b \u0635\u0631\u0641\u0627\u064b \u0627\u062a\u0635\u0627\u0644 \u0628\u0647 \u0631\u0644\u0647\u0654 \u0645\u062d\u0644\u06cc \u06a9\u0627\u0641\u06cc \u0646\u06cc\u0633\u062a.\n- \u0634\u06a9\u0633\u062a \u0628\u0631\u0631\u0633\u06cc \u0627\u0648\u0644 \u062f\u06cc\u06af\u0631 \u067e\u0627\u06cc\u0627\u0646 \u0628\u0631\u0631\u0633\u06cc \u0646\u06cc\u0633\u062a: \u0628\u0631\u0631\u0633\u06cc\u200c\u0647\u0627\u06cc \u0645\u062a\u0648\u0627\u0644\u06cc \u0628\u062f\u0648\u0646 \u0647\u0645\u200c\u067e\u0648\u0634\u0627\u0646\u06cc\u060c \u0628\u0627 \u0641\u0627\u0635\u0644\u0647\u0654 \u06f0\u066b\u06f5\u060c \u06f2\u060c \u06f5\u060c \u06f1\u06f5\u060c \u06f1\u06f5 \u0648 \u0633\u067e\u0633 \u06f6\u06f0 \u062b\u0627\u0646\u06cc\u0647 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0627\u0648\u0644\u06cc\u0646 \u0645\u0648\u0641\u0642\u06cc\u062a \u0628\u0631\u0631\u0633\u06cc\u200c\u0647\u0627 \u0631\u0627 \u0645\u062a\u0648\u0642\u0641 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0648\u0636\u0639\u06cc\u062a \u0633\u0628\u0632 \u062f\u0631 \u0686\u0631\u062e\u0647\u0654 \u0645\u0639\u0645\u0648\u0644 UI \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062a\u0631\u0627\u0641\u06cc\u06a9 \u06a9\u0627\u0631\u0628\u0631 \u0645\u0646\u062a\u0638\u0631 \u062a\u0627\u06cc\u0645\u0631 \u0646\u0645\u06cc\u200c\u0645\u0627\u0646\u062f.\n- \u0645\u0647\u0644\u062a \u0627\u062a\u0635\u0627\u0644/\u062e\u0648\u0627\u0646\u062f\u0646/\u06a9\u0644 \u0628\u0631\u0631\u0633\u06cc \u0628\u0647\u200c\u062a\u0631\u062a\u06cc\u0628 \u06f5\u060c \u06f6 \u0648 \u06f1\u06f2 \u062b\u0627\u0646\u06cc\u0647 \u0627\u0633\u062a\u060c \u0646\u0647 \u062a\u0623\u062e\u06cc\u0631 \u0627\u062c\u0628\u0627\u0631\u06cc. \u0645\u0642\u0635\u062f HTTPS \u062a\u0646\u0638\u06cc\u0645\u200c\u0634\u062f\u0647 \u0648 \u06cc\u06a9 \u0645\u0642\u0635\u062f \u0645\u0633\u062a\u0642\u0644 \u0628\u0647\u200c\u0646\u0648\u0628\u062a \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0647\u0631 \u062f\u0648 \u0627\u0644\u0632\u0627\u0645\u0627\u064b \u0627\u0632 \u0647\u0645\u0627\u0646 \u0645\u0633\u06cc\u0631 \u062a\u0623\u06cc\u06cc\u062f\u0634\u062f\u0647 \u0645\u06cc\u200c\u0631\u0648\u0646\u062f. URL \u0646\u0627\u0645\u0639\u062a\u0628\u0631/HTTP/\u062f\u0627\u0631\u0627\u06cc userinfo \u06cc\u0627 fragment \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. Redirect\u060c \u062f\u0627\u0646\u0644\u0648\u062f \u0628\u062f\u0646\u0647\u060c fallback \u0645\u0633\u062a\u0642\u06cc\u0645 \u0648 \u06a9\u0627\u0647\u0634 \u0627\u0645\u0646\u06cc\u062a TLS \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f.\n- deadline \u0648 \u067e\u0631 \u0628\u0648\u062f\u0646 \u06a9\u0627\u0631\u06af\u0631 \u0646\u062a\u06cc\u062c\u0647\u0654 \u0634\u06a9\u0633\u062a \u0631\u0627 \u0628\u0647 \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f \u0628\u0631\u0645\u06cc\u200c\u06af\u0631\u062f\u0627\u0646\u0646\u062f. STOP\u060c \u062a\u0639\u0648\u06cc\u0636 \u0646\u0634\u0633\u062a \u0648 \u0646\u062a\u06cc\u062c\u0647\u0654 \u062f\u06cc\u0631\u0631\u0633 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0627\u062a\u0635\u0627\u0644 \u062c\u062f\u06cc\u062f \u0631\u0627 \u0633\u0628\u0632 \u06a9\u0646\u0646\u062f \u06cc\u0627 \u0635\u0641 \u0646\u0627\u0645\u062d\u062f\u0648\u062f \u0628\u0633\u0627\u0632\u0646\u062f.\n\n## \u062f\u0627\u0645\u0646\u0647 \u0648 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a \u0645\u0647\u0645\n\n\u0627\u06cc\u0646 \u062a\u0623\u06cc\u06cc\u062f\u060c \u062f\u0633\u062a\u0631\u0633\u06cc HTTPS \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0633\u0631\u0648\u0631/\u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u0631\u06cc\u0645\u0648\u062a\u0650 \u067e\u0631\u0648\u0641\u0627\u06cc\u0644 \u0641\u0639\u0627\u0644 \u0631\u0627 \u0627\u062b\u0628\u0627\u062a \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u062a\u0636\u0645\u06cc\u0646 \u0633\u0644\u0627\u0645\u062a \u062a\u0645\u0627\u0645 \u0633\u0627\u06cc\u062a\u200c\u0647\u0627 \u06cc\u0627 \u062a\u0645\u0627\u0645 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u06cc \u06af\u0648\u0634\u06cc \u0646\u06cc\u0633\u062a. \u0628\u0631\u0627\u06cc full-Xray \u0686\u0646\u062f\u0633\u0631\u0648\u0631\u06cc \u0628\u062f\u0648\u0646 \u06cc\u06a9 \u0633\u0631\u0648\u0631 \u06cc\u06a9\u062a\u0627\u060c full-sing-box \u062f\u0627\u0631\u0627\u06cc \u0645\u0633\u06cc\u0631\u0647\u0627\u06cc \u0646\u0627\u0634\u0646\u0627\u062e\u062a\u0647/\u0645\u0633\u062a\u0642\u06cc\u0645\u060c \u0648 full-Clash \u062f\u0627\u0631\u0627\u06cc DIRECT/\u06af\u0631\u0648\u0647 \u06cc\u0627 provider \u063a\u06cc\u0631\u0642\u0627\u0628\u0644\u200c\u0627\u062b\u0628\u0627\u062a\u060c \u0645\u0633\u06cc\u0631 \u0639\u0627\u062f\u06cc \u062d\u0641\u0638 \u0645\u06cc\u200c\u0634\u0648\u062f \u0627\u0645\u0627 \u0631\u0646\u06af \u0633\u0628\u0632\u0650 \u0628\u062f\u0648\u0646 \u0645\u062f\u0631\u06a9 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0647\u06cc\u0686 \u0633\u0631\u0648\u0631 \u062a\u0635\u0627\u062f\u0641\u06cc \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0686\u0646\u06cc\u0646 \u06a9\u0627\u0646\u0641\u06cc\u06af\u200c\u0647\u0627\u06cc\u06cc \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0647\u0645\u0686\u0646\u0627\u0646 \u06a9\u0627\u0631 \u06a9\u0646\u0646\u062f \u0648 \u0648\u0636\u0639\u06cc\u062a \u062a\u0623\u06cc\u06cc\u062f\u0646\u0634\u062f\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u0646\u062f.\n\n\u062a\u0633\u062a \u0648\u0627\u0642\u0639\u06cc \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc\u060c \u0634\u0628\u06a9\u0647\u0654 \u062e\u0635\u0648\u0635\u06cc\u060c Kill Switch\u060c DNS/IPv6\u060c Doze \u0648 \u0628\u0627\u062a\u0631\u06cc \u0627\u0646\u062c\u0627\u0645 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a\u061b \u06a9\u0627\u0631\u0628\u0631 \u0641\u0639\u0644\u0627\u064b \u0627\u0645\u06a9\u0627\u0646 \u0622\u0646 \u0631\u0627 \u0646\u062f\u0627\u0631\u062f. \u0627\u06cc\u0646 \u0627\u0646\u062a\u0634\u0627\u0631 \u0627\u062f\u0639\u0627\u06cc \u0631\u0641\u0639 \u0647\u0645\u0647\u0654 \u0645\u0648\u0627\u0631\u062f \u0645\u0645\u06cc\u0632\u06cc \u0642\u0628\u0644\u06cc\u060c \u062a\u0636\u0645\u06cc\u0646 \u0632\u0645\u0627\u0646 \u0627\u062a\u0635\u0627\u0644 \u06cc\u0627 \u0627\u062b\u0628\u0627\u062a \u0627\u0648\u0644\u06cc\u0646 \u067e\u0627\u0633\u062e \u0648\u0627\u0642\u0639\u06cc \u0627\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 \u0631\u0627 \u0646\u062f\u0627\u0631\u062f.\n\n## \u0627\u0631\u062a\u0642\u0627\n\n\u0646\u0627\u0645 \u0628\u0633\u062a\u0647 \u062b\u0627\u0628\u062a `com.parvaz.tunnel`\u060c \u06a9\u062f \u0646\u0633\u062e\u0647 \u06f3\u06f2 \u0648 \u0647\u0645\u0627\u0646 \u06a9\u0644\u06cc\u062f \u0627\u0645\u0636\u0627\u06cc \u062f\u0627\u0626\u0645\u06cc \u0646\u0633\u0644 \u0633\u0648\u0645 \u062d\u0641\u0638 \u0645\u06cc\u200c\u0634\u0648\u062f. \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 stable\u060c \u0627\u06cc\u0646 \u0646\u0633\u062e\u0647 \u0627\u0632 \u062f\u06a9\u0645\u0647\u0654 \u0628\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u062f\u0627\u062e\u0644 \u0628\u0631\u0646\u0627\u0645\u0647 \u0646\u06cc\u0632 \u0642\u0627\u0628\u0644 \u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u0633\u062a. \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0631\u062a\u0642\u0627 \u0646\u0633\u062e\u0647\u0654 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0645\u0632\u06af\u0630\u0627\u0631\u06cc\u200c\u0634\u062f\u0647 \u0628\u06af\u06cc\u0631\u06cc\u062f\u061b \u0628\u0631\u0646\u0627\u0645\u0647 \u0631\u0627 \u062d\u0630\u0641 \u0646\u06a9\u0646\u06cc\u062f \u0648 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0631\u0627 \u067e\u0627\u06a9 \u0646\u06a9\u0646\u06cc\u062f. \u0646\u0633\u062e\u0647 \u0648 \u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc 1.26.4 \u062a\u063a\u06cc\u06cc\u0631 \u062f\u0627\u062f\u0647 \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f.\n\n## \u0634\u0648\u0627\u0647\u062f \u0622\u0632\u0645\u0648\u0646 \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631\n\n\u06a9\u062f \u0627\u062c\u0631\u0627\u06cc\u06cc `72f8db89a8424d1d96c25b98329713459e2b7ba7` \u062f\u0631 \u0633\u0627\u062e\u062a Android \u0628\u0627 **\u06f3\u06f1\u06f1 \u0622\u0632\u0645\u0648\u0646\u060c \u0635\u0641\u0631 failure/error/skip** \u0648 R8 \u0645\u0648\u0641\u0642 \u0628\u0631\u0631\u0633\u06cc \u0634\u062f. ReadinessConfig \u0631\u0648\u06cc SDK 29/34 \u0645\u062c\u0645\u0648\u0639\u0627\u064b \u06f2\u06f0 \u062a\u0633\u062a\u060c \u0632\u0645\u0627\u0646\u200c\u0628\u0646\u062f \u06f9 \u062a\u0633\u062a\u060c \u0648 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0645\u062d\u062f\u0648\u062f \u06f1\u06f2 \u062a\u0633\u062a \u062f\u0627\u0631\u062f. \u0647\u0645\u0686\u0646\u06cc\u0646 \u06f3\u06f9 \u062a\u0633\u062a \u0645\u0631\u062a\u0628\u0637 \u0631\u0648\u06cc \u0645\u06cc\u0632\u0628\u0627\u0646 (\u0628\u062f\u0648\u0646 Robolectric \u0628\u0631\u0627\u06cc \u062a\u0633\u062a JSON) \u0645\u0648\u0641\u0642 \u0628\u0648\u062f. \u0646\u062a\u0627\u06cc\u062c \u0645\u06cc\u0632\u0628\u0627\u0646 \u06cc\u0627 \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632\u060c \u062a\u0623\u06cc\u06cc\u062f \u0634\u0628\u06a9\u0647 \u0648 \u06af\u0648\u0634\u06cc \u0648\u0627\u0642\u0639\u06cc \u06a9\u0627\u0631\u0628\u0631 \u0646\u06cc\u0633\u062a\u0646\u062f. \u0634\u0648\u0627\u0647\u062f \u0639\u0645\u0648\u0645\u06cc: `v1.26.5-unit-results.json` \u0648 `v1.26.5-gates.json`.\n\n\u0647\u0631 \u0647\u0641\u062a \u0627\u062c\u0631\u0627\u06cc \u0645\u0634\u0627\u0647\u062f\u0647\u200c\u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0646 \u06a9\u062f \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f: \u062f\u0648 \u0633\u0627\u062e\u062a Android\u060c \u0633\u0647 \u0627\u062c\u0631\u0627\u06cc \u0631\u06af\u0631\u0633\u06cc\u0648\u0646 \u0633\u0627\u0628\u060c \u0622\u0632\u0645\u0648\u0646 \u0627\u0645\u0646\u06cc\u062a \u0622\u0631\u0634\u06cc\u0648/\u0628\u06a9\u0627\u067e \u0631\u0648\u06cc \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632 SDK 29/34 \u0648 \u0627\u0639\u062a\u0628\u0627\u0631\u0633\u0646\u062c\u06cc \u0627\u0645\u0636\u0627\u06cc \u062f\u0627\u0626\u0645\u06cc/\u0633\u0627\u062e\u062a \u0647\u0633\u062a\u0647\u200c\u0647\u0627/\u0628\u0633\u062a\u0647\u200c\u0628\u0646\u062f\u06cc APK. \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632 \u0622\u0631\u0634\u06cc\u0648 \u0627\u0632 fixture \u0645\u0646\u062a\u0634\u0631\u0634\u062f\u0647\u0654 1.26.1 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u062a\u0633\u062a VPN \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u0646\u06cc\u0633\u062a.\n"
}
