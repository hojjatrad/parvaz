  "tarball_url": "https://api.github.com/repos/hojjatrad/parvaz/tarball/v1.28.1",
  "zipball_url": "https://api.github.com/repos/hojjatrad/parvaz/zipball/v1.28.1",
  "body": "# Parvaz 1.28.1 \u2014 \u062d\u0630\u0641 \u0627\u0646\u062a\u0638\u0627\u0631 \u062d\u062f\u0633\u06cc \u0627\u062a\u0635\u0627\u0644 \u0645\u062c\u062f\u062f\n\nversionCode 35\u061b \u0647\u0645\u0627\u0646 \u0628\u0633\u062a\u0647 \u0648 \u06af\u0648\u0627\u0647\u06cc \u062f\u0627\u0626\u0645\u06cc. \u0627\u0646\u062a\u0634\u0627\u0631 \u062c\u062f\u06cc\u062f \u0627\u0633\u062a \u0648 v1.28.0 \u06cc\u0627 \u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u0628\u0627\u0632\u0646\u0648\u06cc\u0633\u06cc \u0646\u0645\u06cc\u200c\u0634\u0648\u0646\u062f.\n\n## \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a \u0627\u06cc\u0646 \u0645\u0631\u062d\u0644\u0647\n\n- \u062f\u0631 \u062f\u0648 \u0645\u0633\u06cc\u0631 \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc \u0634\u0628\u06a9\u0647 \u0648 \u062a\u0639\u0648\u06cc\u0636 \u0633\u0631\u0648\u0631\u060c \u062a\u0648\u0642\u0641 \u062a\u06a9\u0631\u0627\u0631\u06cc \u0648 sleep \u062b\u0627\u0628\u062a 300ms \u062d\u0630\u0641 \u0634\u062f\u0646\u062f. \u062a\u0648\u0642\u0641 \u0648 \u0634\u0631\u0648\u0639 \u062f\u0631 \u0647\u0645\u0627\u0646 worker \u0633\u0631\u06cc\u0627\u0644\u06cc \u0648 \u062f\u0631 CoreManager \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f\u061b \u0634\u0631\u0648\u0639 \u067e\u0633 \u0627\u0632 \u0628\u0627\u0632\u06af\u0634\u062a stopLoop \u0627\u0633\u062a\u060c \u0646\u0647 \u0647\u0645\u200c\u0632\u0645\u0627\u0646 \u0628\u0627 \u0622\u0646.\n- \u0645\u0627\u0644\u06a9\u06cc\u062a \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u067e\u06cc\u0634 \u0627\u0632 \u062a\u0648\u0642\u0641\u060c \u067e\u0633 \u0627\u0632 \u062a\u0648\u0642\u0641 \u0648 \u067e\u06cc\u0634 \u0627\u0632 \u0634\u0631\u0648\u0639 \u06a9\u0646\u062a\u0631\u0644\u0631 \u062f\u0648\u0628\u0627\u0631\u0647 \u0628\u0631\u0631\u0633\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f. \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0644\u063a\u0648\u0634\u062f\u0647 \u067e\u0633 \u0627\u0632 \u062a\u0648\u0642\u0641 \u0646\u0628\u0627\u06cc\u062f \u0647\u0633\u062a\u0647\u0654 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646 \u0628\u0633\u0627\u0632\u062f\u061b callback \u0642\u062f\u06cc\u0645\u06cc \u0647\u0645\u0686\u0646\u0627\u0646 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0646\u0634\u0633\u062a \u062c\u062f\u06cc\u062f \u0631\u0627 \u062a\u0623\u06cc\u06cc\u062f \u06a9\u0646\u062f.\n- \u06af\u0632\u0627\u0631\u0634 \u0632\u0645\u0627\u0646 \u0631\u0627\u0647\u200c\u0627\u0646\u062f\u0627\u0632\u06cc \u0627\u06a9\u0646\u0648\u0646 \u062a\u0648\u0642\u0641 \u0642\u0628\u0644\u06cc \u0631\u0627 \u062f\u0631 \u0645\u0633\u06cc\u0631 \u0648\u0627\u062d\u062f \u0645\u06cc\u200c\u0628\u06cc\u0646\u062f. \u062f\u0627\u0645\u0646\u0647\u0654 \u0632\u0645\u0627\u0646 \u0635\u0631\u06cc\u062d\u0627\u064b \u00ab\u0628\u0627\u0632\u06af\u0634\u062a \u0641\u0631\u0627\u062e\u0648\u0627\u0646\u06cc stop\u00bb \u0627\u0633\u062a\u061b \u067e\u0627\u06cc\u0627\u0646 \u0648\u0627\u0642\u0639\u06cc \u0641\u0631\u0627\u06cc\u0646\u062f \u0641\u0631\u0632\u0646\u062f \u0627\u062f\u0639\u0627 \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u0632\u0645\u0627\u0646 \u0645\u0633\u062a\u0642\u0644 DNS \u0648 \u0627\u0648\u0644\u06cc\u0646 \u067e\u0627\u0633\u062e \u0628\u0631\u0646\u0627\u0645\u0647 \u0647\u0646\u0648\u0632 \u0627\u0646\u062f\u0627\u0632\u0647\u200c\u06af\u06cc\u0631\u06cc \u0646\u0634\u062f\u0647\u200c\u0627\u0646\u062f.\n- \u0628\u0631\u0631\u0633\u06cc native \u062c\u062f\u06cc\u062f \u0628\u0631\u0627\u06cc \u0628\u0627\u0632\u0627\u0633\u062a\u0641\u0627\u062f\u0647\u0654 \u0641\u0648\u0631\u06cc \u0627\u0632 \u0647\u0645\u0627\u0646 \u067e\u0648\u0631\u062a Xray \u0648 \u0632\u0646\u062c\u06cc\u0631\u0647\u0654 Xray\u2192sing-box/Mihomo \u0627\u0641\u0632\u0648\u062f\u0647 \u0634\u062f\u0647 \u0627\u0633\u062a. \u062a\u0633\u062a\u200c\u0647\u0627 \u0641\u0642\u0637 \u0631\u0648\u06cc loopback \u0634\u0628\u06cc\u0647\u200c\u0633\u0627\u0632 \u0648 \u0628\u062f\u0648\u0646 TUN \u0648\u0627\u0642\u0639\u06cc \u0647\u0633\u062a\u0646\u062f\u061b \u0646\u062a\u06cc\u062c\u0647\u0654 \u0646\u0647\u0627\u06cc\u06cc \u062f\u0631 \u0634\u0648\u0627\u0647\u062f CI \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f.\n\n## \u0686\u0631\u0627 sleep \u062d\u0630\u0641 \u0634\u062f\u061f\n\n\u062f\u0631 [\u0633\u0648\u0631\u0633 wrapper \u067e\u06cc\u0646\u200c\u0634\u062f\u0647](https://raw.githubusercontent.com/2dust/AndroidLibXrayLite/d0c6c4ae1b09c912070c8288bd0dbcc2e492ac29/libv2ray_main.go)\u060c `StopLoop` \u0632\u06cc\u0631 mutex\u060c `coreInstance.Close()` \u0631\u0627 \u067e\u06cc\u0634 \u0627\u0632 \u0628\u0627\u0632\u06af\u0634\u062a \u0641\u0631\u0627\u062e\u0648\u0627\u0646\u06cc \u0645\u06cc\u200c\u06a9\u0646\u062f. sleep \u062b\u0627\u0628\u062a \u0642\u0631\u0627\u0631\u062f\u0627\u062f \u062a\u06a9\u0645\u06cc\u0644 \u062c\u062f\u06cc\u062f\u06cc \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f. \u0627\u06cc\u0646 \u0628\u0631\u0631\u0633\u06cc \u0633\u0648\u0631\u0633 \u0628\u0647\u200c\u062a\u0646\u0647\u0627\u06cc\u06cc \u0627\u062b\u0628\u0627\u062a \u0631\u0641\u062a\u0627\u0631 binary \u0646\u06cc\u0633\u062a\u061b \u0622\u0632\u0645\u0648\u0646 native \u067e\u0648\u0631\u062a/\u062a\u0631\u0627\u0641\u06cc\u06a9 \u0646\u06cc\u0632 gate \u0627\u0646\u062a\u0634\u0627\u0631 \u0627\u0633\u062a.\n\n\u0641\u0631\u0632\u0646\u062f\u0627\u0646 native \u0647\u0645\u0686\u0646\u0627\u0646 \u062a\u0627 \u062e\u0631\u0648\u062c \u0648\u0627\u0642\u0639\u06cc \u0633\u0647\u0645 \u0638\u0631\u0641\u06cc\u062a \u0648 \u0645\u0646\u0627\u0628\u0639\u0634\u0627\u0646 \u0631\u0627 \u0646\u06af\u0647 \u0645\u06cc\u200c\u062f\u0627\u0631\u0646\u062f. \u0646\u0645\u0648\u0646\u0647\u0654 \u062a\u0627\u0632\u0647 \u067e\u0648\u0631\u062a\u060c \u06af\u0630\u0631\u0648\u0627\u0698\u0647 \u0648 \u062f\u0627\u06cc\u0631\u06a9\u062a\u0648\u0631\u06cc \u062e\u0635\u0648\u0635\u06cc \u062a\u0627\u0632\u0647 \u062f\u0627\u0631\u062f\u061b \u0627\u0646\u062a\u0638\u0627\u0631 \u0648\u0627\u0642\u0639\u06cc \u0638\u0631\u0641\u06cc\u062a \u062d\u0630\u0641 \u0646\u0634\u062f\u0647 \u0648 \u0632\u0648\u062f\u062a\u0631 \u0622\u0632\u0627\u062f \u0646\u0645\u06cc\u200c\u0634\u0648\u062f. \u062d\u0630\u0641 300ms \u06cc\u0639\u0646\u06cc \u062d\u0630\u0641 \u06cc\u06a9 \u062a\u0623\u062e\u06cc\u0631 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0631\u06cc\u0632\u06cc\u200c\u0634\u062f\u0647\u060c \u0646\u0647 \u062a\u0636\u0645\u06cc\u0646 \u0628\u0647\u0628\u0648\u062f 300ms \u0631\u0648\u06cc \u0647\u0631 \u06af\u0648\u0634\u06cc \u06cc\u0627 \u0627\u062a\u0635\u0627\u0644 \u0641\u0648\u0631\u06cc.\n\n## \u062d\u0641\u0638 \u0631\u0641\u062a\u0627\u0631 \u0648 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627\n\n\u0633\u0628\u0632\u0634\u062f\u0646 \u0641\u0642\u0637 \u0628\u0627 \u0645\u062f\u0631\u06a9 \u0645\u0639\u062a\u0628\u0631 HTTPS \u0645\u0633\u06cc\u0631 \u0627\u0646\u062a\u062e\u0627\u0628\u200c\u0634\u062f\u0647\u060c \u0648\u0627\u0628\u0633\u062a\u0647 \u0628\u0647 \u0646\u0634\u0633\u062a/\u0634\u0628\u06a9\u0647/DNS \u0641\u0639\u0644\u06cc \u0627\u0633\u062a. TTL \u0645\u062f\u0631\u06a9\u060c \u062d\u0633\u0627\u0628\u200c\u06a9\u0631\u062f\u0646 \u0632\u0645\u0627\u0646 \u062e\u0648\u0627\u0628\u060c \u06a9\u0646\u062a\u0631\u0644 \u0645\u0646\u0628\u0639 \u0641\u0639\u0627\u0644\u060c \u0633\u06cc\u0627\u0633\u062a \u062a\u062d\u0645\u0644 \u0627\u062e\u062a\u0644\u0627\u0644\u060c \u062f\u0627\u0646\u0644\u0648\u062f \u0627\u062e\u062a\u06cc\u0627\u0631\u06cc \u0648 \u062a\u0623\u06cc\u06cc\u062f \u0646\u0635\u0628 \u06a9\u0627\u0631\u0628\u0631 \u062d\u0641\u0638 \u0634\u062f\u0647\u200c\u0627\u0646\u062f. debounce \u062a\u063a\u06cc\u06cc\u0631 \u0634\u0628\u06a9\u0647 \u062d\u0630\u0641 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a.\n\n\u067e\u0627\u06a9\u200c\u0633\u0627\u0632\u06cc \u062f\u0631\u062c\u0627 \u0648 \u0627\u062d\u0631\u0627\u0632\u0634\u062f\u0647\u0654 cache \u062f\u0631 \u0647\u0645\u0647\u0654 \u0644\u0627\u06cc\u0647\u200c\u0647\u0627\u060c \u0627\u0646\u062a\u0642\u0627\u0644 TTL \u0628\u06cc\u0646 \u0645\u0648\u062a\u0648\u0631\u0647\u0627\u06cc \u0645\u062a\u0641\u0627\u0648\u062a\u060c DNS timing \u0648 \u0627\u0648\u0644\u06cc\u0646 \u067e\u0627\u0633\u062e \u0645\u0633\u062a\u0642\u0644 \u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u06a9\u0645\u06cc\u0644 \u0646\u0634\u062f\u0647\u200c\u0627\u0646\u062f. \u062a\u063a\u06cc\u06cc\u0631 DNS \u0647\u0646\u0648\u0632 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0647\u0633\u062a\u0647 \u0648 \u0633\u0648\u06a9\u062a\u200c\u0647\u0627\u06cc \u0628\u0627\u0632 \u0631\u0627 \u0628\u0627\u0632\u0633\u0627\u0632\u06cc/\u0642\u0637\u0639 \u06a9\u0646\u062f. \u06af\u0648\u0634\u06cc \u0648\u0627\u0642\u0639\u06cc\u060c Kill Switch\u060c \u0646\u0634\u062a DNS/IPv6\u060c \u0628\u0627\u062a\u0631\u06cc\u060c Doze\u060c handover \u0648 \u0646\u0635\u0628 \u0631\u0648\u06cc \u06af\u0648\u0634\u06cc \u06a9\u0627\u0631\u0628\u0631 NOT_RUN \u0647\u0633\u062a\u0646\u062f. \u0622\u0632\u0645\u0648\u0646 \u062c\u062f\u06cc\u062f Xray \u0628\u062f\u0648\u0646 TUN\u060c \u0647\u0645\u200c\u0632\u06cc\u0633\u062a\u06cc \u067e\u0631\u0648\u0628 \u0628\u0627 VPN \u0632\u0646\u062f\u0647 \u0631\u0627 \u062b\u0627\u0628\u062a \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f.\n\n\u0647\u0633\u062a\u0647\u200c\u0647\u0627 \u0647\u0645\u0627\u0646 pin\u0647\u0627\u06cc \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647\u0654 \u0646\u0633\u062e\u0647\u0654 \u0642\u0628\u0644\u200c\u0627\u0646\u062f\u061b \u00ab\u062c\u062f\u06cc\u062f\u062a\u0631\u06cc\u0646 stable \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647\u00bb \u0628\u0627 \u00ab\u0622\u062e\u0631\u06cc\u0646 \u0627\u0646\u062a\u0634\u0627\u0631 \u0641\u0648\u0631\u06cc \u0647\u0631 upstream\u00bb \u06cc\u06a9\u06cc \u0646\u06cc\u0633\u062a. \u0628\u0631\u0631\u0633\u06cc \u0634\u0634\u200c\u0633\u0627\u0639\u062a\u0647 \u0648 \u0627\u0646\u062a\u0634\u0627\u0631 \u0645\u0634\u0631\u0648\u0637 \u0646\u0633\u062e\u0647\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0647\u0633\u062a\u0647\u200c\u0647\u0627 \u062d\u0641\u0638 \u0634\u062f\u0647 \u0627\u0633\u062a.\n\n\u067e\u06cc\u0634 \u0627\u0632 \u0627\u0631\u062a\u0642\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0645\u0632\u062f\u0627\u0631 \u0628\u06af\u06cc\u0631\u06cc\u062f\u061b \u0628\u0631\u0646\u0627\u0645\u0647 \u0648 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0631\u0627 \u062d\u0630\u0641 \u0646\u06a9\u0646\u06cc\u062f.\n\n## \u0634\u0648\u0627\u0647\u062f \u067e\u06cc\u0634 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631\n\n- commit \u0622\u0632\u0645\u0648\u062f\u0647\u200c\u0634\u062f\u0647: `884d6316a59422dbbfb71de2ec4823fcfc488ebe`. \u0633\u0627\u062e\u062a \u0648 \u0622\u0632\u0645\u0648\u0646\u200c\u0647\u0627\u06cc \u0648\u0627\u062d\u062f \u0627\u0646\u062f\u0631\u0648\u06cc\u062f\u060c R8/lint\u060c \u0647\u0633\u062a\u0647\u200c\u0647\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0648 \u0622\u0631\u0634\u06cc\u0648/\u067e\u0634\u062a\u06cc\u0628\u0627\u0646 \u0631\u0648\u06cc SDK29/34 \u0648 \u0628\u0631\u0631\u0633\u06cc metadata \u0647\u0631 \u0633\u0647 upstream \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f.\n- \u0645\u0633\u06cc\u0631 APK \u0628\u062f\u0648\u0646 \u0627\u0645\u0636\u0627\u060c \u06a9\u0646\u062a\u0631\u0644 tree/hash \u0648 \u0627\u0645\u0636\u0627\u06cc \u0648\u0627\u0642\u0639\u06cc \u0628\u0627 \u06a9\u0644\u06cc\u062f \u062f\u0627\u0626\u0645\u06cc \u0631\u0648\u06cc runner \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u0645\u0648\u0641\u0642 \u0634\u062f. guard \u0639\u0627\u062f\u06cc \u0628\u062f\u0648\u0646 \u06a9\u0644\u06cc\u062f \u0647\u0645\u0686\u0646\u0627\u0646 \u0634\u06a9\u0633\u062a \u0645\u06cc\u200c\u062e\u0648\u0631\u062f\u061b \u0641\u0642\u0637 \u0646\u0627\u0645\u0632\u062f \u0635\u0631\u06cc\u062d\u0650 \u0628\u062f\u0648\u0646 \u0627\u0645\u0636\u0627 \u0627\u0633\u062a\u062b\u0646\u0627\u0633\u062a.\n- 36 \u062a\u0633\u062a Python \u0627\u0646\u062a\u0634\u0627\u0631 \u0648 audit \u0645\u06cc\u0632\u0628\u0627\u0646 \u0645\u0648\u0641\u0642 \u0634\u062f\u0646\u062f. \u062e\u0631\u0648\u062c\u06cc \u062a\u0641\u0635\u06cc\u0644\u06cc workflow\u0647\u0627 \u062f\u0631 JSON\u0647\u0627\u06cc \u06a9\u0646\u0627\u0631 \u0647\u0645\u06cc\u0646 \u06cc\u0627\u062f\u062f\u0627\u0634\u062a \u062b\u0628\u062a \u0634\u062f\u0647 \u0627\u0633\u062a.\n- \u0622\u0632\u0645\u0648\u0646 \u06af\u0648\u0634\u06cc \u0648 \u0634\u0628\u06a9\u0647\u0654 \u062e\u0635\u0648\u0635\u06cc NOT_RUN \u0628\u0627\u0642\u06cc \u0645\u06cc\u200c\u0645\u0627\u0646\u062f. \u0646\u062a\u06cc\u062c\u0647\u0654 \u0628\u0631\u0631\u0633\u06cc \u0641\u0627\u06cc\u0644\u200c\u0647\u0627\u06cc \u0639\u0645\u0648\u0645\u06cc \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u0634\u0627\u0631 \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u062b\u0628\u062a \u0645\u06cc\u200c\u0634\u0648\u062f.\n"
}
