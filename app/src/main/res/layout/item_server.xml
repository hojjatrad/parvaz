<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/card" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground" android:focusable="true" android:clickable="true"
    android:padding="@dimen/server_card_padding" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@id/flag" android:layout_width="32dp" android:layout_height="wrap_content"
            android:textSize="20sp" android:gravity="center" android:text="🌐" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="?android:textColorPrimary"
                android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@id/address" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="?android:textColorSecondary" android:textDirection="ltr"
                android:maxLines="1" android:ellipsize="middle" />
            <TextView android:id="@id/badge" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/brand_text" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView android:id="@id/check" android:layout_width="24dp" android:layout_height="24dp"
            android:layout_marginStart="4dp" android:visibility="invisible" android:src="@drawable/ic_check" app:tint="@color/brand_text"
            android:contentDescription="@string/server_selected" />
        <TextView android:id="@id/fav" style="@style/ActionText"
            android:layout_width="@dimen/touch_target_min" android:layout_height="@dimen/touch_target_min"
            android:gravity="center" android:textSize="22sp" android:text="☆"
            android:contentDescription="@string/favorite_add" />
    </LinearLayout>
    <TextView android:id="@id/ping" style="@style/ActionText"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:gravity="start|center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="13sp" android:textStyle="bold" android:text="@string/latency_untested" />
</LinearLayout>
