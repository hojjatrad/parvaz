# build output
build/
.gradle/
*.apk
*.aab
*.idsig

# native blobs and the core AAR are fetched by tools/setup_android.sh
app/libs/
*.aar
*.so

# secrets — never commit
.keys/
*.keystore
*.jks
ghtoken
mapping*.txt

# Local audit/compiler cache
.cache/

# Local credentials and machine-specific Android configuration
.env
.env.*
local.properties
signing.properties
*.p12

# Short-lived CI test artifacts
test-results/

# Generated release outputs (publish as Releases assets, never Git blobs)
release-artifacts/

# Legacy binary archives must not re-enter the source tree
release/*.zip
